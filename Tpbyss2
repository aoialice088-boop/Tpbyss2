    end
end

-- TP Path Avoid (evita obstáculos)
local function teleportPathAvoid(targetPos)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local startPos = hrp.Position
    
    statusLabel.Text = "🛤️ Calculando rota...\nEvitando obstáculos..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    
    -- Verifica se tem obstáculo direto
    if hasObstacle(startPos, targetPos) then
        statusLabel.Text = "⚠️ Obstáculo detectado!\nTentando rota alternativa..."
        
        -- Tenta rotas alternativas (sobe, desce, laterais)
        local alternatives = {
            Vector3.new(targetPos.X, targetPos.Y + 10, targetPos.Z), -- sobe
            Vector3.new(targetPos.X + 10, targetPos.Y, targetPos.Z), -- direita
            Vector3.new(targetPos.X - 10, targetPos.Y, targetPos.Z), -- esquerda
            Vector3.new(targetPos.X, targetPos.Y - 10, targetPos.Z), -- desce
        }
        
        for _, altPos in ipairs(alternatives) do
            if not hasObstacle(startPos, altPos) and not hasObstacle(altPos, targetPos) then
                statusLabel.Text = "✅ Rota alternativa encontrada!\nExecutando..."
                teleportWalkSim(altPos)
                task.wait(0.5)
                teleportWalkSim(targetPos)
                return
            end
        end
        
        statusLabel.Text = "❌ Nenhuma rota limpa encontrada\nUse Phase Mode"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    -- Rota direta está limpa
    teleportWalkSim(targetPos)
end

tpBtn.MouseButton1Click:Connect(function()
    if not selectedWaypoint or not waypoints[selectedWaypoint] then
        statusLabel.Text = "❌ Selecione um waypoint"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local wp = waypoints[selectedWaypoint]
    local targetPos = Vector3.new(wp.pos.X, wp.pos.Y, wp.pos.Z)
    
    if currentMode == "Phase" then
        teleportPhase(targetPos)
    elseif currentMode == "Walk" then
        teleportWalkSim(targetPos)
    elseif currentMode == "Path" then
        teleportPathAvoid(targetPos)
    end
end)
