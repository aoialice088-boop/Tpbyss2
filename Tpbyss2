-- Detecção de obstáculos no caminho
local function hasObstacle(startPos, endPos)
    local direction = (endPos - startPos)
    local distance = direction.Magnitude
    direction = direction.Unit
    
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {player.Character}
    
    local ray = Workspace:Raycast(startPos, direction * distance, rayParams)
    
    return ray ~= nil
end

-- TP com Phase Mode (desativa colisão)
local function teleportPhase(targetPos)
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end
    
    local startPos = hrp.Position
    local distance = math.sqrt(
        (targetPos.X - startPos.X)^2 + 
        (targetPos.Y - startPos.Y)^2 + 
        (targetPos.Z - startPos.Z)^2
    )
    
    local stepSize = tonumber(stepSizeInput.Text) or 0.3
    local delay = tonumber(delayInput.Text) or 0.05
    local steps = math.max(5, math.floor(distance / stepSize))
    
    statusLabel.Text = "👻 Phase TP...\nDesativando colisão..."
    statusLabel.TextColor3 = Color3.fromRGB(200, 100, 255)
    
    -- Salva estado original
    local originalCollide = hrp.CanCollide
    local originalPartsCollide = {}
    
    -- Desativa colisão de todas as partes do personagem
    if phaseEnabled then
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                originalPartsCollide[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end
    
    -- Move em micro-steps
    for i = 1, steps do
        local progress = i / steps
        local currentPos = Vector3.new(
            startPos.X + (targetPos.X - startPos.X) * progress,
            startPos.Y + (targetPos.Y - startPos.Y) * progress,
            startPos.Z + (targetPos.Z - startPos.Z) * progress
        )
        hrp.CFrame = CFrame.new(currentPos)
        task.wait(delay)
    end
    
    hrp.CFrame = CFrame.new(targetPos.X, targetPos.Y, targetPos.Z)
    
    -- Restaura colisão
    if phaseEnabled then
        for part, original in pairs(originalPartsCollide) do
            if part and part.Parent then
                part.CanCollide = original
            end
        end
    end
    
    -- Verifica resultado
    local finalPos = hrp.Position
    local error = math.sqrt(
        (finalPos.X - targetPos.X)^2 + 
        (finalPos.Y - targetPos.Y)^2 + 
        (finalPos.Z - targetPos.Z)^2
    )
    
    if error < 1 then
        statusLabel.Text = "✅ Phase TP completo\nAtravessou paredes\nErro: " .. string.format("%.2f", error) .. " studs"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 150)
    else
        statusLabel.Text = "⚠️ Servidor corrigiu posição\nErro: " .. string.format("%.2f", error) .. " studs"
        statusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    end
end

-- TP Walk Sim (normal)
